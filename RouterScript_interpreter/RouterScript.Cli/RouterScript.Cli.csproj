<Project Sdk="Microsoft.NET.Sdk">

  <!-- Brief 17: offline runner for router language scripts (run one script, or a folder of tests). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>RouterScript.Cli</AssemblyName>
    <RootNamespace>VerbalCommands.RouterScript.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RouterScript\RouterScript.csproj" />
  </ItemGroup>

</Project>
