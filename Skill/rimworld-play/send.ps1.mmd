    W --> O["wait for outbox\name.json, TimeoutSec (:154-162)"]
    O --> RJ{"rejected + 'A plan is waiting'? (:168)"}
    RJ -- yes --> RT["wait inbox_state waiting = none, send again (:169-182)"]
    RJ -- no --> S["Slim: drop file, kind, mode, order_id, turn, text, utc and empty values; print one JSON line (:114-152, :188)"]
